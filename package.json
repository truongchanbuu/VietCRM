{
  "name": "salesforce-develop-kit",
  "private": true,
  "version": "1.0.0",
  "description": "Reusable Salesforce query and HTTP integration modules",
  "scripts": {
    "lint": "npm run check:modules",
    "test": "npm run check:modules && npm run format:core:check",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "check:modules": "node --test scripts/quality/check-modules.test.mjs && node scripts/quality/check-modules.mjs",
    "format:core:check": "prettier --check \"force-app/**/*.{cls,trigger,xml}\" \"scripts/quality/*.mjs\" \"config/modules.json\"",
    "validate:core": "node scripts/quality/validate-core.mjs",
    "analyze:core": "mkdir -p artifacts && sf code-analyzer run --workspace force-app --target force-app --rule-selector pmd:Recommended --include-fixes --severity-threshold 2 --output-file artifacts/code-analyzer-results-ci.json"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ]
  }
}
